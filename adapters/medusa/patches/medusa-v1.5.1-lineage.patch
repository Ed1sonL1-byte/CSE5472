+// CallSequenceGeneration returns a defensive copy of the provenance for the sequence currently being executed.
+func (fw *FuzzerWorker) CallSequenceGeneration() CallSequenceGeneration {
+	if fw.sequenceGenerator == nil {
+		return CallSequenceGeneration{}
+	}
+	generation := fw.sequenceGenerator.generation
+	generation.ParentHashes = append([]string(nil), generation.ParentHashes...)
+	return generation
+}
+
+func (g *CallSequenceGenerator) recordParent(sequence calls.CallSequence) error {
+	hash, err := sequence.Hash()
+	if err != nil {
+		return err
+	}
+	g.generation.ParentHashes = append(g.generation.ParentHashes, hash.Hex())
+	return nil
 }
 
