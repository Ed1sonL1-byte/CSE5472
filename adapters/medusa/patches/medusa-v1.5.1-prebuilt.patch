+package platforms
+
+import "github.com/crytic/medusa/compilation/types"
+
+// prebuiltArtifacts survives JSON round trips inside NewFuzzer. The key is the
+// source path recorded as the compilation target.
+var prebuiltArtifacts = map[string][]types.Compilation{}
+
+// PrebuiltCompilationConfig returns artifacts compiled outside PATH solc.
+type PrebuiltCompilationConfig struct {
+	Target string `json:"target"`
+}
+
+func NewPrebuiltCompilationConfig(target string, compilations []types.Compilation) *PrebuiltCompilationConfig {
+	prebuiltArtifacts[target] = compilations
+	return &PrebuiltCompilationConfig{Target: target}
+}
+
+func (p *PrebuiltCompilationConfig) Compile() ([]types.Compilation, string, error) {
+	compiled, ok := prebuiltArtifacts[p.Target]
+	if !ok {
+		return nil, "", errMissingPrebuilt(p.Target)
+	}
+	return compiled, "", nil
+}
+
+func (p *PrebuiltCompilationConfig) Platform() string { return "prebuilt" }
+
+func (p *PrebuiltCompilationConfig) GetTarget() string { return p.Target }
+
+func (p *PrebuiltCompilationConfig) SetTarget(target string) { p.Target = target }
+
+func errMissingPrebuilt(target string) error {
+	return &prebuiltError{target}
+}
+
+type prebuiltError struct{ target string }
+
+func (e *prebuiltError) Error() string {
+	return "no prebuilt compilation registered for " + e.target
+}
